# Grafana secrets — populate .env with real values, never commit .env.
#
# GF_SMTP_PASSWORD: app password Outlook/Office365 (16 char).
#   Genera su https://account.microsoft.com > Sicurezza > Password app.
GF_SMTP_PASSWORD=change-me
#
# OAuth client (registrato in Authentik come Provider OIDC per Grafana):
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=change-me
GF_AUTH_GENERIC_OAUTH_CLIENT_SECRET=change-me
