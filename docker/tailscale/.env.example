# Tailscale auth key.
# Generate at: https://login.tailscale.com/admin/settings/keys
#
# Once the container has authenticated and persisted state in
# /var/lib/tailscale (mounted volume), the key is no longer required at
# runtime — the node re-authenticates via the stored machine key.
# Keep the value here for reproducibility on fresh deploys / disaster recovery.
TS_AUTHKEY=tskey-auth-XXXXXXXXXXXXXX
