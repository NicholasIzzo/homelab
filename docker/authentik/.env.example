# Authentik stack secrets — populate .env with real values, never commit .env.
#
# PG_PASS: password Postgres per l'utente 'authentik'.
#   Genera con: openssl rand -base64 36 | tr -d '\n'
PG_PASS=change-me
#
# AUTHENTIK_SECRET_KEY: chiave di firma sessioni/cookie Authentik.
#   Genera con: openssl rand -base64 60 | tr -d '\n'
AUTHENTIK_SECRET_KEY=change-me
#
# Error reporting to upstream Sentry (goauthentik.io). Default: disabilitato.
AUTHENTIK_ERROR_REPORTING__ENABLED=false
#
# Porte host per l'UI Authentik (evita conflitti con altri stack sul NAS).
COMPOSE_PORT_HTTP=9002
COMPOSE_PORT_HTTPS=9443
