# Copia in `.env` e compila. Il file .env NON va mai committato.

# URL del server Jellyfin (hpserver, installazione nativa).
JELLYFIN_URL=http://192.168.0.33:8096

# API key: Jellyfin → Dashboard → API Keys → "+" → nome "videostore".
# Se resta vuota il negozio parte in modalità DEMO con titoli finti.
JELLYFIN_API_KEY=

# Tabellone "in arrivo al cinema": due strade, basta una delle due.
# 1) Jellyseerr (consigliata, nessun account nuovo): la API key è in
#    Jellyseerr → Impostazioni → Generale → API Key.
JELLYSEERR_URL=http://192.168.0.36:5055
JELLYSEERR_API_KEY=
# 2) Oppure una key TMDb (https://www.themoviedb.org/settings/api).
TMDB_API_KEY=
# Senza nessuna delle due, il tabellone mostra gli ultimi arrivi della libreria.
