# Copiare in .env sull'host di deploy e compilare. .env NON va nel repo.

TZ=Europe/Rome
LOG_LEVEL=info

# --- Sorgenti di monitoring (usate dalla Fase 3) ---

# SSH verso il NAS: chiave dedicata, non riusata.
NAS_SSH_HOST=192.168.0.36
NAS_SSH_USER=nicholasizzo
# Percorso DENTRO il container (vedi il mount in docker-compose.yaml).
NAS_SSH_KEY=/run/secrets/ssh_key
# Percorso della chiave SULL'HOST. Deve essere leggibile da uid 1000.
NAS_SSH_KEY_HOST_PATH=/home/nicholas/.ssh/id_ed25519_hub
# Impronta della host key del NAS, per il pinning. Ricavarla con:
#   ssh-keyscan -t ed25519 192.168.0.36 | ssh-keygen -lf -
NAS_SSH_HOST_FINGERPRINT=
RESTIC_STATE_PATH=/var/lib/nas-backup/state.json

# Scrutiny: nessuna autenticazione.
SCRUTINY_URL=http://192.168.0.36:8087

# Uptime Kuma: porta 3002 (la 3001 e' Gitea).
# La chiave si genera in Kuma: Profilo -> API Keys. Formato uk1_...
UPTIME_KUMA_URL=http://192.168.0.36:3002
UPTIME_KUMA_API_KEY=

# Certificato TLS Vaultwarden dietro NPM.
# IP Tailscale + SNI esplicito: un container in rete bridge non risolve i nomi .ts.net.
VAULTWARDEN_TLS_HOST=100.98.207.48
VAULTWARDEN_TLS_PORT=44075
VAULTWARDEN_TLS_SERVERNAME=dh4300plus-fix.taile39e4f.ts.net

# --- Autenticazione ---

# Hash argon2id della password. Finche' e' vuoto l'app NON serve alcun dato:
# ogni rotta protetta risponde 503. Generalo cosi' (la password viene chiesta
# a schermo, non passa dalla cronologia della shell):
#   docker run --rm -it homelab-hub:1.1.0 node server/dist/tools/hash-password.js
ADMIN_PASSWORD_HASH=

# Durata della sessione in giorni. Si rinnova da sola oltre la meta' della vita.
SESSION_DAYS=90

# Lasciare false: l'app e' servita in HTTP sull'IP Tailscale e la riservatezza
# la garantisce WireGuard. Con secure=true il browser non invierebbe il cookie
# e il login sarebbe impossibile. Metterlo a true solo dietro un reverse proxy HTTPS.
COOKIE_SECURE=false
