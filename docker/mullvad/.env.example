# Mullvad WireGuard secrets — .env NON committato, mai qui i valori veri.
#
# WIREGUARD_PRIVATE_KEY
#   Genera / rigenera in: https://mullvad.net/en/account/wireguard-config
#   -> "Generate key" -> copia il campo "Private key" (base64, 44 caratteri).
#   Nota: generare una nuova key INVALIDA quella vecchia sul lato Mullvad.
WIREGUARD_PRIVATE_KEY=change-me
#
# WIREGUARD_ADDRESSES
#   Nella stessa pagina di Mullvad, sotto la key, campo "IPv4 Address".
#   Formato: 10.X.Y.Z/32 (ogni key ha un IP dedicato).
WIREGUARD_ADDRESSES=10.X.Y.Z/32
